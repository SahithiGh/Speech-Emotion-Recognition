# Copy to .env.local and edit. All values are optional; nothing here is a secret (VITE_ values are public in the browser).
# Address of the API when it is NOT served from the same site (leave empty for local use; the dev server proxies /api).
VITE_API_BASE=
# Public address of the site, used for canonical links and sitemap.xml, for example https://your-domain.example
VITE_SITE_URL=
# Contact email shown on the Contact page. If empty, the Contact page says that no contact is configured.
VITE_CONTACT_EMAIL=
# Link to the project source code (optional).
VITE_REPO_URL=
